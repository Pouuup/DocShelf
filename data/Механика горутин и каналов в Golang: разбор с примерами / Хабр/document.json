				{
					"Type": "paragraph",
					"Text": "sender просыпается и отправляет \"message 2\" в канал ch."
				},
				{
					"Type": "paragraph",
					"Text": "receiver обрабатывает сообщение: "
				},
				{
					"Type": "paragraph",
					"Text": "Выводит: \"Received: message 2\"."
				},
				{
					"Type": "paragraph",
					"Text": "Отправитель снова засыпает на 100 мс."
				},
				{
					"Type": "paragraph",
					"Text": "sender просыпается и отправляет \"message 3\" в канал ch."
				},
				{
					"Type": "paragraph",
					"Text": "receiver обрабатывает сообщение: "
				},
				{
					"Type": "paragraph",
					"Text": "Выводит: \"Received: message 3\"."
